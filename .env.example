# Canonical site URL used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://yarafrica.org

# --- Forms (newsletter, interest list, contact, mentor, partner) ---
# Configure at least one in production, otherwise submissions show an error with the email fallback.
# JSON POST of every submission (Zapier, Make, n8n, Google Apps Script, Formspree...)
FORMS_WEBHOOK_URL=
# Or email each submission via Resend
RESEND_API_KEY=
FORMS_FROM_EMAIL="YARA Website <website@yarafrica.org>"
FORMS_NOTIFY_EMAIL=info@yarafrica.org

# --- Links that stay hidden until confirmed ---
NEXT_PUBLIC_AI_ETHICS_APPLY_URL=
NEXT_PUBLIC_AI_ETHICS_STATUS=
NEXT_PUBLIC_DONATION_URL=

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
